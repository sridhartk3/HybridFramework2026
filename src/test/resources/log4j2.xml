<?xml version="1.0" encoding="UTF-8"?>
<!-- Put in src/test/resources (or src/main/resources) -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>
    </Console>
    <File name="File" fileName="target/logs/test.log" append="false">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.poi" level="warn"/>
    <Root level="info">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
