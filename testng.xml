<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hybrid Suite" verbose="1">
  <listeners>
    <listener class-name="com.framework.listeners.TestListener"/>
    <listener class-name="com.framework.listeners.RetryTransformer"/>
  </listeners>

  <!-- For parallel runs add: parallel="methods" thread-count="3" (driver is ThreadLocal) -->
  <test name="Hybrid Tests">
    <packages>
      <package name="com.framework.tests.*"/>
    </packages>
  </test>
</suite>
